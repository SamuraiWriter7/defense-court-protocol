{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/cyber-defense-constitution.schema.json",
  "title": "Cyber Defense Constitution",
  "description": "A schema for defining the Seventeen-Article Cyber Defense Charter under the Defense Court Protocol.",
  "type": "object",
  "required": [
    "cyber_defense_constitution"
  ],
  "additionalProperties": false,
  "properties": {
    "cyber_defense_constitution": {
      "type": "object",
      "required": [
        "protocol",
        "version",
        "charter_name",
        "layer",
        "purpose",
        "core_principles",
        "modules",
        "articles"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": "string",
          "const": "Defense Court Protocol"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "charter_name": {
          "type": "string",
          "const": "AI Seventeen-Article Cyber Defense Charter"
        },
        "layer": {
          "type": "string",
          "const": "Defense Kernel"
        },
        "purpose": {
          "type": "string",
          "description": "Purpose of the cyber defense constitution."
        },
        "core_principles": {
          "type": "array",
          "description": "Core principles of the cyber defense constitution.",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "human_responsibility",
              "authorized_command",
              "protocol_discipline",
              "traceability",
              "role_clarity",
              "safety_over_availability",
              "containment_before_expansion",
              "verification_before_recovery",
              "governance_before_irreversible_action",
              "collective_review_for_major_decisions"
            ]
          },
          "uniqueItems": true
        },
        "modules": {
          "type": "object",
          "description": "Functional modules derived from the Seventeen-Article Cyber Defense Charter.",
          "required": [
            "synchronization_module",
            "authority_module",
            "protocol_module",
            "trace_and_trust_module",
            "safety_and_containment_module"
          ],
          "additionalProperties": false,
          "properties": {
            "synchronization_module": {
              "$ref": "#/$defs/module_definition"
            },
            "authority_module": {
              "$ref": "#/$defs/module_definition"
            },
            "protocol_module": {
              "$ref": "#/$defs/module_definition"
            },
            "trace_and_trust_module": {
              "$ref": "#/$defs/module_definition"
            },
            "safety_and_containment_module": {
              "$ref": "#/$defs/module_definition"
            }
          }
        },
        "articles": {
          "type": "array",
          "description": "The seventeen cyber defense articles.",
          "minItems": 17,
          "maxItems": 17,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "module",
              "principle",
              "rule",
              "required_behaviors",
              "prohibited_behaviors",
              "trace_requirements",
              "human_review_required_for"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 17
              },
              "title": {
                "type": "string",
                "description": "Article title."
              },
              "module": {
                "$ref": "#/$defs/constitution_module"
              },
              "principle": {
                "type": "string",
                "description": "Short principle represented by the article."
              },
              "rule": {
                "type": "string",
                "description": "Normative rule for cyber defense behavior."
              },
              "required_behaviors": {
                "type": "array",
                "description": "Behaviors required by this article.",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "prohibited_behaviors": {
                "type": "array",
                "description": "Behaviors prohibited by this article.",
                "items": {
                  "type": "string"
                }
              },
              "trace_requirements": {
                "type": "array",
                "description": "Trace fields or trace-related obligations required by this article.",
                "items": {
                  "$ref": "#/$defs/trace_requirement"
                },
                "uniqueItems": true
              },
              "human_review_required_for": {
                "type": "array",
                "description": "Situations where human review is required under this article.",
                "items": {
                  "$ref": "#/$defs/human_review_trigger"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "constitution_module": {
      "type": "string",
      "enum": [
        "synchronization_module",
        "authority_module",
        "protocol_module",
        "trace_and_trust_module",
        "safety_and_containment_module"
      ]
    },
    "module_definition": {
      "type": "object",
      "required": [
        "description",
        "article_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "article_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 17
          },
          "uniqueItems": true
        }
      }
    },
    "trace_requirement": {
      "type": "string",
      "enum": [
        "trace_id",
        "timestamp",
        "incident_type",
        "affected_scope",
        "acting_agent",
        "agent_rank",
        "authority_scope",
        "applicable_articles",
        "decision",
        "reason",
        "reversibility",
        "safeguards",
        "verification_status",
        "governance_status",
        "human_review_status",
        "next_required_action"
      ]
    },
    "human_review_trigger": {
      "type": "string",
      "enum": [
        "irreversible_action",
        "critical_incident",
        "public_disclosure",
        "legal_notification",
        "production_wide_shutdown",
        "permanent_sanction",
        "recovery_from_critical_compromise",
        "cross_system_credential_revocation",
        "public_risk_incident",
        "major_containment_action",
        "major_recovery_action"
      ]
    }
  }
}
```
